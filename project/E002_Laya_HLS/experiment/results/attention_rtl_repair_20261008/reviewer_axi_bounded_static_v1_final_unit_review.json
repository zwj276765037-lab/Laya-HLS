  "source_audit": [
    {
      "item": "Bounded representation",
      "evidence": "Endpoint module-scope four-state byte backing,4 AW/AR/B descriptors,64 W entries,one R slot. No dynamic/class/UVM/fork or timed automatic helper. Generic PAGE_CAPACITY/PAGE_BASES bounded scan."
    },
    {
      "item": "Complete physical addressing",
      "evidence": "page_slot compares bits63:12; parameter pages aligned/unique. burst_error65-bit end detects overflow; aligned INCR1..16 beats, supported byte sizes and4KiB boundaries. Unknown accepted metadata rejected."
    },
    {
      "item": "Write lifecycle",
      "evidence": "Independent AW/W ready and queues; write_commit consumes old nonempty queues, validates WID/WLAST/WSTRB, commits strobed lanes with NBA before B is visible; each count has one owner and simultaneous push/pop arithmetic."
    },
    {
      "item": "Read lifecycle",
      "evidence": "Read slot only fills while !rvalid; stalls retain all outputs. Read beat advances on actual R handshake, last pops AR; unused narrow lanes zero. Same-clock mem write uses NBA so read samples old data."
    },
    {
      "item": "Reset and preservation",
      "evidence": "Synchronous reset clears protocol counts/heads/beat and R slot, never mem. TB applies quiescent warm reset after512 pairs per width and checks no stale B/R/queues plus full32768-byte memory equality."
    },
    {
      "item": "Independent monitor/oracle",
      "evidence": "negedge clocked driver; posedge wire monitor validates exact AW/W/AR payload; separately maps64-bit address ranges into expected bytes and compares every R data/ID/RESP/LAST and B after real memory commit. Final verifier executes before PASS."
    },
    {
      "item": "Coverage and counts",
      "evidence": "Per width512 pairs; length classes1/2/16 occur171/171/170 times, sum3233 beats. All4pages,IDs0/1,full/narrow/nonzero lanes,zero/sparse/full strobe,boundary ending,256 AW-first and256 W-first,>=3 B/R stalls asserted. Aggregate1024 AW/B/AR and6466 W/R observed."
    },
    {
      "item": "Expected rejection",
      "evidence": "32-bit endpoint gets aligned4-byte burst atpage+4092,len1 crossing4KiB and fails before queue write atline185/65ns; separate len1 transaction gets early WLAST and fails atline230/85ns.512-bit agent idle in these modes."
    }
  ],
