-// One bank-request return. Wq/Ws are read once per column and broadcast to
-// four rows; each shape-valid PS and lane_bad bank has one request. The source
-// event loop below asks for a registered, one-cycle bank return. HLS mapping
-// and the actual return edge are separate later evidence gates.
-struct C1BankReturn {
-  bool valid;
-  ap_uint<17> seq;
-  ap_uint<4> m0;
-  ap_uint<7> g;
-  ap_uint<10> tile;
-  ap_uint<6> result_slot;
-  ap_uint<1> trace_reserved;
-  ap_uint<2> trace_slot;
-  ap_uint<32> shape_mask, bad_mask;
-  ap_uint<256> a[4], w[8];
-  uint16_t sa[4], sw[8];
-  uint32_t old_ps[32];
-};
-
-struct C1Flight {
-  bool valid;
-  c1::ResultPayload result;
-  ap_uint<256> trace_payload;
-};
-
-constexpr unsigned kC1FlightStages = 17;  // one bank return + 17 = requested 18
-
-void prepare_c1_a(c1::ASlot& slot, unsigned m0, unsigned g, unsigned rows,
-                  ap_uint<256> aq[4][kA8Depth], uint16_t as[4][kA8Depth]) {
-  slot.data = 0;
-  slot.m0 = m0;
-  slot.g = g;
-  for (unsigned rr = 0; rr < 4; ++rr) {
-#pragma HLS UNROLL
-    if (m0 + rr < rows) {
-      const unsigned address = (m0 / 4) * 128 + g;
-      slot.data.range(rr * 288 + 255, rr * 288) = aq[rr][address];
-      slot.data.range(rr * 288 + 271, rr * 288 + 256) = as[rr][address];
-    }
-  }
-  slot.valid = true;
-}
-
-C1Flight evaluate_c1_return(const C1BankReturn& read, unsigned rows,
-                            unsigned N, unsigned G, bool trace_enabled,
-                            unsigned trace_row, unsigned trace_column) {
-#pragma HLS INLINE off
-  C1Flight flight = {};
-  flight.valid = read.valid;
-  if (!read.valid) return flight;
-  c1::ResultPayload& out = flight.result;
-  out.seq = read.seq;
-  out.m0 = read.m0;
-  out.g = read.g;
-  out.tile = read.tile;
-  out.last_g = unsigned(read.g) + 1 == G;
-  out.result_slot = read.result_slot;
-  out.trace_reserved = read.trace_reserved;
-  out.trace_slot = read.trace_slot;
-  out.shape_mask = read.shape_mask;
-  out.active_mask = read.shape_mask & ~read.bad_mask;
-  out.success_mask = 0;
-  out.failure_mask = 0;
-  out.error_valid = 0;
-  out.error_key = 0;
-  out.error_bad_element = 0;
-  out.active_dot_count = 0;
-  flight.trace_payload = 0;
-  for (unsigned rr = 0; rr < 4; ++rr) {
-#pragma HLS UNROLL
-    const unsigned r = unsigned(read.m0) + rr;
-    const uint32_t sa_raw = c1::half_to_f32_bits(read.sa[rr]);
-    for (unsigned cc = 0; cc < 8; ++cc) {
-#pragma HLS UNROLL
-      const unsigned bank = rr * 8 + cc;
-      const unsigned n = unsigned(read.tile) * 8 + cc;
-      if (!out.active_mask[bank]) continue;
-      const int32_t dot = c1::dot32(read.a[rr], read.w[cc]);
-      const uint32_t sw_raw = c1::half_to_f32_bits(read.sw[cc]);
-      const c1::RestoreLane lane = c1::restore_lane(
-          dot, sa_raw, sw_raw, read.old_ps[bank], read.g == 0);
-      out.active_dot_count = out.active_dot_count + 1;
-      if (lane.phase == 4) {
-        out.success_mask[bank] = 1;
-        out.next_ps[bank] = lane.next_raw;
-      } else {
-        out.failure_mask[bank] = 1;
-        const ap_uint<28> key = c1::error_key(read.tile, r, cc, read.g, lane.phase);
-        if (!out.error_valid || key < out.error_key) {
-          out.error_valid = 1;
-          out.error_key = key;
-          out.error_bad_element = uint64_t(r) * 5248 * 128 +
-                                  uint64_t(n) * 128 + unsigned(read.g);
-        }
-      }
-      if (trace_enabled && read.trace_reserved && r == trace_row &&
-          n == trace_column) {
-        flight.trace_payload.range(31, 0) = uint32_t(dot);
-        flight.trace_payload.range(63, 32) = lane.sa_raw;
-        flight.trace_payload.range(95, 64) = lane.sw_raw;
-        flight.trace_payload.range(127, 96) = lane.product_raw;
-        flight.trace_payload.range(159, 128) = lane.term_raw;
-        flight.trace_payload.range(191, 160) = lane.next_raw;
-        flight.trace_payload.range(223, 192) = unsigned(read.g);
-        flight.trace_payload.range(255, 224) = 1;
-      }
-    }
-  }
-  return flight;
-}
-bool send_word(c1_write::Router& router, c1_write::Port port,
-               c1_write::Kind kind, uint64_t word_offset, uint32_t value) {
-  c1_write::Command command = {};
-  command.word_offset = word_offset;
-  command.count = 1;
-  command.kind = kind;
-  command.payload.range(31, 0) = value;
-  return router.send_and_wait(port, command);
-}
-
-bool send_report(c1_write::Router& router,
-                 const uint32_t header[O_HEADER_WORDS]) {
-  for (unsigned start = 0; start < O_HEADER_WORDS; start += 16) {
-    c1_write::Command command = {};
-    command.word_offset = start;
-    command.count = O_HEADER_WORDS - start < 16 ? O_HEADER_WORDS - start : 16;
-    command.kind = c1_write::REPORT;
-    for (unsigned j = 0; j < unsigned(command.count); ++j)
-      command.payload.range(j * 32 + 31, j * 32) = header[start + j];
-    if (!router.send_and_wait(c1_write::OBSERVED, command)) return false;
-  }
-  return true;
-}
-
-bool send_eos(c1_write::Router& router, c1_write::Port port) {
-  c1_write::Command command = {};
-  command.kind = c1_write::EOS;
-  return router.send_and_wait(port, command);
-}
