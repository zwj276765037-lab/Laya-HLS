-void run_c1_core(
-    const uint32_t* descriptor, const ap_uint<512>* w_q0,
-    const ap_uint<512>* w_q1, const ap_uint<512>* w_scale,
-    const uint32_t* aux, const ap_uint<512>* activation,
-    c1_write::CommandStream& out0_commands,
-    c1_write::CommandStream& out1_commands,
-    c1_write::CommandStream& observed_commands,
-    c1_write::AckStream& out0_acks,
-    c1_write::AckStream& out1_acks,
-    c1_write::AckStream& observed_acks) {
-#pragma HLS INLINE off
-
-  static State st;
-#ifdef __SYNTHESIS__
-#pragma HLS reset variable=st
-#endif
-  static ap_uint<256> wq[8][kWDepth];
-  static uint16_t ws[8][kWDepth];
