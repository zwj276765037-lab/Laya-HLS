-  require(!rig.credit.submit(rig.commands,
-          rig.make(1, c1_write::QUANT_Q, 1), true),
-          "same-edge acknowledgment credit reused");
-  rig.submit(rig.make(1, c1_write::QUANT_Q, 1));
-  rig.drain_after_stalls(2);
-}
