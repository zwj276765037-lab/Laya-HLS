-void unmatched_token_and_quiescent_eos() {
-  Rig bad;
-  bad.submit(bad.make(1, c1_write::REPORT, 0));
-  bad.acks.write(c1_write::pack(c1_write::Ack{c1_write::FINAL_OUTPUT, 0, 0}));
