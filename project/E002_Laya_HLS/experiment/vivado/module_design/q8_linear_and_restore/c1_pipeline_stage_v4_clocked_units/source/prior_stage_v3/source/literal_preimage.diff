-void prepare_c1_a(c1::ASlot& slot, unsigned m0, unsigned g, unsigned rows,
-                  ap_uint<256> aq[4][kA8Depth], uint16_t as[4][kA8Depth]) {
-  slot.data = 0;
-  slot.m0 = m0;
-  slot.g = g;
-  for (unsigned rr = 0; rr < 4; ++rr) {
-#pragma HLS UNROLL
-    if (m0 + rr < rows) {
-      const unsigned address = (m0 / 4) * 128 + g;
-      slot.data.range(rr * 288 + 255, rr * 288) = aq[rr][address];
-      slot.data.range(rr * 288 + 271, rr * 288 + 256) = as[rr][address];
-    }
-  }
-  slot.valid = true;
-}
-
-// This actor owns Q64/D4 metadata, PS/lane_bad and all bank request/return
-// arbitration. It never computes a dot or FP restore and never waits for AXI
-// response. One pending bank request separates accepted issue from the bank
-// return interface; its physical read edge/II remains UNMEASURED.
-bool run_c1_m0_control(
-    unsigned m0, unsigned rows, unsigned N, unsigned G, unsigned T,
-    bool trace_enabled, unsigned trace_row, unsigned trace_column,
-    ap_uint<256> wq[8][kWDepth], uint16_t ws[8][kWDepth],
-    ap_uint<256> aq[4][kA8Depth], uint16_t as[4][kA8Depth],
-    float ps[32][kPsDepth], bool lane_bad[32][kPsDepth],
-    c1_write::Router& router, Counts& counts,
-    uint64_t& first_rank, uint64_t& bad_element,
-    hls::stream<c1_stage::BankReturn>& bank_returns,
-    hls::stream<c1_stage::FinalReturn>& final_returns) {
-#pragma HLS INLINE off
-  c1::ResultRing results;
-  c1::TraceRing traces;
-  c1::TileHazards hazards;
-  results.reset_metadata();
-  traces.reset_metadata();
-  hazards.reset_metadata();
-  c1::ASlot a_slots[2];
-  a_slots[0].valid=false;
-  a_slots[1].valid=false;
-  c1_stage::BankRequest pending_request;
-  bool pending_valid=false;
-  const unsigned total_vectors=G*T;
-  unsigned issued_here=0, retired_here=0;
-  unsigned next_g=0, next_tile=0;
-  while (issued_here!=total_vectors || retired_here!=total_vectors ||
-         pending_valid || traces.free_count!=c1::kTraceSlots ||
-         !router.observed.drained()) {
-    results.start_edge();
-    traces.start_edge();
-    bool observed_got=false;
-    c1_write::Ack observed_ack;
-    if (!router.edge(observed_got,observed_ack)) return false;
-    if (observed_got) {
-      if (observed_ack.kind!=c1_write::GROUP_TRACE ||
-          observed_ack.trace_slot!=traces.drain_head ||
-          !traces.retire_head_after_b()) return false;
-    }
-    if (traces.head_canceled() && !traces.retire_head_after_b()) return false;
-
-    // Oldest physical commit is ordered and independent of any writer stall.
-    // A return read below cannot commit in this same arbitration step.
-    c1::ResultPayload committed;
-    if (results.can_commit()) {
-      if (!results.commit_oldest(committed)) return false;
-      const unsigned tile=unsigned(committed.tile);
-      for (unsigned bank=0;bank<32;++bank) {
-#pragma HLS UNROLL
-        if (committed.success_mask[bank])
-          ps[bank][tile]=c1::f32(uint32_t(committed.next_ps[bank]));
-        if (committed.failure_mask[bank]) lane_bad[bank][tile]=true;
-      }
-      counts.macs+=uint64_t(unsigned(committed.active_dot_count))*32;
-      ++counts.retired; ++retired_here;
-      if (committed.error_valid &&
-          uint32_t(committed.error_key)<first_rank) {
-        first_rank=uint32_t(committed.error_key);
-        bad_element=uint64_t(committed.error_bad_element);
-      }
-      if (committed.trace_reserved) {
-        const unsigned rr=trace_row-m0, cc=trace_column%8;
-        const bool success=committed.success_mask[rr*8+cc];
-        if (!traces.publish(committed.trace_slot,committed.seq,success))
-          return false;
-        if (success) {
-          counts.trace_words+=kTraceGroupWords;
-          ++counts.trace_groups;
-        }
-      }
-      hazards.on_physical_commit(tile);
-    }
-
-    c1_stage::FinalReturn returned;
-    if (final_returns.read_nb(returned)) {
-      if (returned.alignment_fault || !returned.valid ||
-          !results.return_result(returned.result.result_slot,
-                                 returned.result)) return false;
-      if (returned.result.trace_reserved &&
-          !traces.return_payload(returned.result.trace_slot,
-                                 returned.result.seq,
-                                 returned.trace_payload)) return false;
-    }
-
-    // Bank service: request and return are separate valid interfaces. The
-    // pending request holds tag/addresses while a depth-one return FIFO is
-    // backpressured. All 32 PS/lane_bad reads use the same tag, with +0 for g0.
-    if (pending_valid) {
-      const c1_stage::BankRequest& request=pending_request;
-      const c1::ASlot& a_slot=a_slots[unsigned(request.tag.g)&1u];
-      if (!a_slot.valid || a_slot.m0!=request.tag.m0 ||
-          a_slot.g!=request.tag.g) return false;
-      c1_stage::BankReturn bank_return;
-      bank_return.tag=request.tag;
-      bank_return.tag.bad_mask=0;
-      for (unsigned row=0;row<4;++row) {
-#pragma HLS UNROLL
-        bank_return.a[row]=a_slot.data.range(row*288+255,row*288);
-        bank_return.sa_half[row]=a_slot.data.range(row*288+271,row*288+256);
-        for (unsigned column=0;column<8;++column) {
-#pragma HLS UNROLL
-          const unsigned bank=row*8+column;
-          bank_return.tag.bad_mask[bank]=lane_bad[bank][request.ps_address];
-          const bool active=request.tag.shape_mask[bank] &&
-                            !bank_return.tag.bad_mask[bank];
-          // g0, out-of-shape, and previously failed lanes have no valid PS.
-          // They carry canonical +0 without reading uninitialized payload.
-          bank_return.old_ps[bank]=request.ps_read_enable && active ?
-              bits(ps[bank][request.ps_address]) : 0u;
-        }
-      }
-      for (unsigned column=0;column<8;++column) {
-#pragma HLS UNROLL
-        bank_return.w[column]=wq[column][request.w_address];
-        bank_return.sw_half[column]=ws[column][request.w_address];
-      }
-      if (bank_returns.write_nb(bank_return)) pending_valid=false;
-    }
-
-    if (traces.head_ready() && router.observed.free_at_edge) {
-      const ap_uint<2> slot=traces.drain_head;
-      const ap_uint<256> payload=traces.payload[slot];
-      c1_write::Command command={};
-      command.kind=c1_write::GROUP_TRACE;
-      command.count=8;
-      command.trace_slot=slot;
-      command.word_offset=kTraceGroupWord+
-          unsigned(payload.range(223,192))*kTraceGroupWords;
-      command.payload.range(255,0)=payload;
-      if (router.submit(c1_write::OBSERVED,command)) {
-        ap_uint<256> copied;
-        if (!traces.start_send(copied) || copied!=payload) return false;
-      }
-    }
-
-    if (!pending_valid && issued_here<total_vectors &&
-        hazards.issue_ready(next_tile) && results.can_reserve()) {
-      const bool trace_needed=trace_enabled &&
-          trace_row>=m0 && trace_row<m0+4 &&
-          trace_column/8==next_tile;
-      if (!trace_needed || traces.can_reserve()) {
-        ap_uint<6> result_slot;
-        ap_uint<2> trace_slot=0;
-        if (!results.reserve(result_slot)) return false;
-        if (trace_needed &&
-            !traces.reserve(ap_uint<17>(issued_here),trace_slot))
-          return false;
-        if (next_tile==0)
-          prepare_c1_a(a_slots[next_g&1u],m0,next_g,rows,aq,as);
-        c1_stage::BankRequest request;
-        request.tag.valid=1;
-        request.tag.seq=issued_here;
-        request.tag.m0=m0;
-        request.tag.g=next_g;
-        request.tag.tile=next_tile;
-        request.tag.last_g=next_g+1==G;
-        request.tag.result_slot=result_slot;
-        request.tag.trace_reserved=trace_needed;
-        request.tag.trace_slot=trace_slot;
-        request.tag.trace_lane=trace_needed ?
-            (trace_row-m0)*8+trace_column%8 : 0;
-        request.tag.shape_mask=0;
-        request.tag.bad_mask=0;
-        for (unsigned row=0;row<4;++row)
-          for (unsigned column=0;column<8;++column)
-            request.tag.shape_mask[row*8+column]=
-                (m0+row<rows && next_tile*8+column<N);
-        request.w_address=next_tile*G+next_g;
-        request.a_address=(m0/4)*128+next_g;
-        request.ps_address=next_tile;
-        request.ps_read_enable=next_g!=0;
-        pending_request=request;
-        pending_valid=true;
-        hazards.on_issue(next_tile);
-        ++counts.issued; ++issued_here;
-        ++next_tile;
-        if (next_tile==T) { next_tile=0; ++next_g; }
-      }
-    }
-    if (!results.conserved()) return false;
-    hazards.end_arbitration_step();
-  }
-  return !pending_valid && router.drained() &&
-         results.free_count==c1::kResultSlots &&
-         traces.free_count==c1::kTraceSlots;
-}
-
-bool run_c1_m0_stream(
-    unsigned m0, unsigned rows, unsigned N, unsigned G, unsigned T,
-    bool trace_enabled, unsigned trace_row, unsigned trace_column,
-    ap_uint<256> wq[8][kWDepth], uint16_t ws[8][kWDepth],
-    ap_uint<256> aq[4][kA8Depth], uint16_t as[4][kA8Depth],
-    float ps[32][kPsDepth], bool lane_bad[32][kPsDepth],
-    c1_write::Router& router, Counts& counts,
-    uint64_t& first_rank, uint64_t& bad_element) {
-#pragma HLS INLINE off
-  hls::stream<c1_stage::BankReturn> bank_returns("bank_returns");
-  hls::stream<c1_stage::FinalReturn> final_returns("final_returns");
-#pragma HLS STREAM variable=bank_returns depth=1
-#pragma HLS STREAM variable=final_returns depth=1
-  const unsigned total_vectors=G*T;
-#ifdef __SYNTHESIS__
-#pragma HLS DATAFLOW
-  const bool completed=run_c1_m0_control(
-      m0,rows,N,G,T,trace_enabled,trace_row,trace_column,
-      wq,ws,aq,as,ps,lane_bad,router,counts,first_rank,bad_element,
-      bank_returns,final_returns);
-  c1_stage::run_operand_pipeline(bank_returns,final_returns,total_vectors);
-  return completed;
-#else
-  // The host path uses a concurrent actor thread. Its stream completion does
-  // not imply an HLS cycle count, fixed return latency or physical B timing.
-  std::thread stages([&] {
-    c1_stage::run_operand_pipeline(bank_returns,final_returns,total_vectors);
-  });
-  const bool completed=run_c1_m0_control(
-      m0,rows,N,G,T,trace_enabled,trace_row,trace_column,
-      wq,ws,aq,as,ps,lane_bad,router,counts,first_rank,bad_element,
-      bank_returns,final_returns);
-  if (!completed) __builtin_trap();  // terminal source invariant, no hang
-  stages.join();
-  return true;
-#endif
-}
