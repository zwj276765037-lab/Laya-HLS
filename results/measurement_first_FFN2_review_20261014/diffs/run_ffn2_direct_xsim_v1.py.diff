+def runtime_libraries():
+    """Record the loader-resolved transitive libraries, including system libs."""
+    env = dict(os.environ)
+    env['LD_LIBRARY_PATH'] = ':'.join((str(LIB), str(BIN.parent /
+        'tps/lnx64/gcc-9.3.0/lib64')))
+    binaries = (OLD_CWD / 'xsim.dir' / SNAP / 'xsimk',
+                BIN / 'loader', BIN / 'unwrapped/lnx64.o/xsim')
+    found = {}
+    for binary in binaries:
+        proc = subprocess.run(['ldd', str(binary)], env=env, capture_output=True,
+                              text=True, timeout=30, check=True)
+        if 'not found' in proc.stdout:
+            raise RuntimeError(f'unresolved library for {binary}')
+        for line in proc.stdout.splitlines():
+            words = line.strip().split()
+            candidate = next((w for w in words if w.startswith('/') and
+                              Path(w).is_file()), None)
+            if candidate:
+                path = Path(candidate).resolve(strict=True)
+                found[str(path)] = {'path': str(path), **digest(path)}
+    return sorted(found.values(), key=lambda x: x['path'])
 
 
